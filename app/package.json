{
  "name": "menh-ly-3d",
  "productName": "Menh Ly 3D",
  "version": "1.0.0",
  "description": "Mệnh Lý 3D: tử vi, bát tự, chiêm tinh, Kinh Dịch, tarot với AI luận giải",
  "author": "Craftbyte",
  "main": "dist/main.js",
  "license": "MIT",
  "scripts": {
    "bundle": "node build.mjs",
    "start": "node build.mjs && electron .",
    "build:win": "node build.mjs && electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "esbuild": "^0.25.0",
    "three": "^0.170.0",
    "@types/three": "^0.170.0"
  },
  "build": {
    "appId": "asia.craftbyte.menhly3d",
    "productName": "Menh Ly 3D",
    "copyright": "Craftbyte",
    "files": [
      "dist/main.js",
      "preload.js",
      "web/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "MenhLy3D-${version}.exe"
    }
  }
}